# Porta do Gateway
PORT=8080

# Chave que os adapters (ex.: integracoes/juvo) usam no header x-api-key.
# Precisa ser o MESMO valor configurado no GATEWAY_API_KEY do adapter.
GATEWAY_API_KEY=

# Credencial do Firebase Admin (Application Default Credentials), pra
# escrever no Firestore do projeto "guedesloc". Duas opções:
#   (a) baixar uma chave de service account no Console do Firebase
#       (Configurações do projeto > Contas de serviço) e apontar aqui:
#       GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
#   (b) rodar `gcloud auth application-default login` numa conta com acesso
#       ao projeto — nesse caso não precisa definir essa variável aqui.
GOOGLE_APPLICATION_CREDENTIALS=

# Project ID do GCP/Firebase (usado pro Firestore e pro Cloud Logging).
GOOGLE_CLOUD_PROJECT=guedesloc

# Nome do log no Cloud Logging (Logs Explorer > guedesloc-gateway-backend).
LOG_NAME=guedesloc-gateway-backend

# Cloud Logging — desligado por padrão, local os logs já saem estruturados
# no console (stdout/stderr). Só ligar (true) depois de garantir que a
# service account acima (ou a gateway_sa do infra/terraform) tem o papel
# roles/logging.logWriter no projeto — o SA padrão do Firebase Admin SDK
# NÃO tem esse papel por padrão, então ligar sem isso só gera erros
# PERMISSION_DENIED nos logs.
CLOUD_LOGGING_ENABLED=false

# Sentry (rastreamento de erros centralizado) — desligado enquanto vazio.
# Preencher com o DSN do projeto Sentry (criar em sentry.io > New Project >
# Node.js/Express) pra ativar.
SENTRY_DSN=

# Origem(ns) permitida(s) a chamar o Gateway direto do navegador (CORS),
# separadas por vírgula.
FRONTEND_ORIGIN=http://localhost:5173

# WhatsApp via Z-API (backlog Fase 4) — desligado enquanto vazio: sem
# ZAPI_INSTANCE_ID/ZAPI_TOKEN, o envio é SIMULADO. Preencher com os dados de
# https://app.z-api.io (painel > Instâncias) pra ativar de verdade.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Segredo que o Gateway exige do webhook da Z-API (header x-webhook-secret
# ou ?secret= na URL) — sem isso, /api/v1/whatsapp/webhook rejeita tudo
# com 401. Gerar um valor aleatório (ex.: `openssl rand -hex 24`).
WHATSAPP_WEBHOOK_SECRET=
