# Credenciais Juvo
JUVO_LOGIN_URL=https://juvo.com.br/juvoweb/api/login
JUVO_USERNAME=
JUVO_PASSWORD=

# Portal alvo (Tempo Assist)
PORTAL_URL=https://novo-portal-prestador.prd.tempoassist.cloud/

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=juvo_user
MYSQL_PASSWORD=juvo_pass
MYSQL_DATABASE=juvo_automation

# Cron schedule (padrão: todo dia às 6h e 18h)
CRON_SCHEDULE=0 6,18 * * *

# Playwright: true = sem interface, false = com navegador visível (debug)
HEADLESS=true

# Porta da tela de visualização (npm run viewer)
VIEWER_PORT=3000

# Gateway (backend/) — único ponto autorizado a escrever no Firestore
GATEWAY_URL=http://localhost:8080
GATEWAY_API_KEY=

# Cloud Logging (Logs Explorer > guedesloc-juvo-rpa) — desligado por padrão
# (CLOUD_LOGGING_ENABLED=false), local os logs já saem estruturados no
# console. Só ligar depois que a service account abaixo tiver o papel
# "Logs Writer" / roles/logging.logWriter no projeto (ver infra/terraform) —
# sem isso a chamada volta com PERMISSION_DENIED.
CLOUD_LOGGING_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=../../backend/guedesloc-firebase-adminsdk-fbsvc-6dc4c6b729.json
GOOGLE_CLOUD_PROJECT=guedesloc
LOG_NAME=guedesloc-juvo-rpa
